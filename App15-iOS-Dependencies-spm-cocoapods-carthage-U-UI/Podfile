# Podfile — CocoaPods Dependencies for App15
# Run: pod install
# Open: App15.xcworkspace (not App15.xcodeproj)

platform :ios, '18.0'
use_frameworks!

target 'App15' do
  # Animation
  pod 'lottie-ios', '~> 4.0'

  # Networking
  pod 'Alamofire', '~> 5.0'
  pod 'Moya', '~> 15.0'

  # Data & Storage
  pod 'GRDB.swift', '~> 6.0'

  # Dependency Injection
  pod 'Factory', '~> 2.0'
end

target 'App15Tests' do
  inherit! :search_paths
end

target 'App15UITests' do
  inherit! :search_paths
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '18.0'
      config.build_settings['SWIFT_VERSION'] = '5.0'
    end
  end
end

          "startingLine": 73
        }
      },
      {
        "comment": "",
        "key": "Was ist ein Ersatznachweis?",
        "location": {
          "startingColumn": 34,
          "startingLine": 31
        }
      },
      {
        "comment": "",
        "key": "Nachweis anfordern",
        "location": {
          "startingColumn": 34,
          "startingLine": 37
        }
      },
      {
        "comment": "",
        "key": "Sie haben Ihre Gesundheitskarte vergessen? Mit einem Ersatznachweis können Sie trotzdem Ihren Arzttermin wahrnehmen.",
        "location": {
          "startingColumn": 26,
          "startingLine": 23
        }
      },
      {
        "comment": "",
        "key": "Karte nicht dabei?",
        "location": {
          "startingColumn": 34,
          "startingLine": 16
        }
      },
      {
        "comment": "",
        "key": "Kein Problem – wir helfen Ihnen.",
        "location": {
          "startingColumn": 34,
          "startingLine": 18
        }
      },
      {
        "comment": "",
        "key": "Ersatznachweis anfordern",
        "location": {
          "startingColumn": 26,
          "startingLine": 41
        }
      },
      {
        "comment": "",
        "key": "Der Ersatznachweis gilt ausschließlich bei deutschen Arztpraxen und Krankenhäusern und ersetzt nicht die eigentliche Gesundheitskarte.",
        "location": {
          "startingColumn": 26,
          "startingLine": 53
        }
      },
      {
        "comment": "",
        "key": "Anfordern",
        "location": {
          "startingColumn": 20,
          "startingLine": 68
        }
      },
      {
        "comment": "",
        "key": "Abbrechen",
        "location": {
          "startingColumn": 20,
          "startingLine": 69
        }
      },
      {
        "comment": "",
        "key": "Ein Ersatznachweis wird erstellt und in Ihr Postfach gesendet.",
        "location": {
          "startingColumn": 18,
          "startingLine": 71
        }
      },
      {
        "comment": "",
        "key": "OK",
        "location": {
          "startingColumn": 20,
          "startingLine": 74
        }
      },
      {
        "comment": "",
        "key": "Ihr Ersatznachweis befindet sich jetzt in Ihrem Postfach. Er ist 10 Tage gültig.",
